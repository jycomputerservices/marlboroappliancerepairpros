# Marlboro Appliance Repair Pros — Environment Configuration
# Copy this file to .env and fill in real values before deploying

# Server
NODE_ENV=development
PORT=3005

# Business Info
BUSINESS_PHONE="(732) 555-0100"
BUSINESS_EMAIL=info@marlboroappliancerepairpros.com
SITE_URL=https://marlboroappliancerepairpros.com

# Webhook Integration (REQUIRED for lead forwarding)
# Get your webhook URL from Zapier, Make, or Go High Level
WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXX/YYYYY/
WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# Generate a secure WEBHOOK_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Optional: Secondary webhook for backup/failover
WEBHOOK_URL_SECONDARY=

# Analytics (optional)
GA4_MEASUREMENT_ID=

# reCAPTCHA (optional, for spam protection)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
